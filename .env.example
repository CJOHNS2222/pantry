# Gemini AI
VITE_GEMINI_API_KEY=your_gemini_api_key

# OpenRouter (fallback/alternate AI provider - used for recipe search + vision
# when Gemini quota is unavailable; also the sole AI path in prod when
# featureFlags routes searchRecipes away from Gemini)
VITE_OPENROUTER_API_KEY=your_openrouter_api_key
VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VITE_OPENROUTER_MODEL=your_openrouter_text_model
VITE_OPENROUTER_VISION_MODEL=your_openrouter_vision_model

# USDA FoodData Central API (Free - get key at https://fdc.nal.usda.gov/api-key-signup.html)
VITE_USDA_API_KEY=your_usda_api_key

# Spoonacular API (Free tier: 150 requests/day)
VITE_SPOONACULAR_API_KEY=your_spoonacular_api_key

# Google Custom Search Engine
VITE_GOOGLE_CSE_API_KEY=your_cse_api_key
VITE_GOOGLE_CSE_ID=your_cse_id

# Unsplash (fallback ingredient/recipe image source)
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Firebase Configuration
VITE_API_KEY=your_firebase_api_key
VITE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_PROJECT_ID=your_project_id
VITE_STORAGE_BUCKET=your_project.appspot.com
VITE_MESSAGING_SENDER_ID=your_sender_id
VITE_APP_ID=your_app_id
VITE_MEASUREMENT_ID=your_measurement_id

# Sentry error reporting (production builds only)
VITE_SENTRY_DSN=your_sentry_dsn
VITE_SENTRY_ENVIRONMENT=production

# reCAPTCHA (App Check / bot protection)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# EmailJS (Optional)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# AdMob (Android only — leave false on web/dev, set true for production release builds)
# Requires admob_app_id in android/app/src/main/res/values/strings.xml
VITE_ADMOB_ENABLED=false
# Set to true to use Google test ad units during development/testing
VITE_ADMOB_USE_TEST=false

# Impact Affiliate Program (Instacart/Walmart/etc. checkout tracking)
# The account SID/auth token are NOT client env vars (they were a Basic-auth
# account secret getting inlined into the public bundle/APK - see .claude/audits/FIXES.md F04).
# They're now Cloud Functions secrets, set once via:
#   firebase functions:secrets:set IMPACT_ACCOUNT_SID
#   firebase functions:secrets:set IMPACT_AUTH_TOKEN
# See functions/src/impactTracking.ts.
VITE_IMPACT_PUBLISHER_ID=your_impact_publisher_id

# Retailer affiliate campaign/ad IDs (services/groceryCheckoutService.ts) - one
# campaign+ad ID pair per supported retailer, all optional.
VITE_WALMART_CAMPAIGN_ID=your_walmart_campaign_id
VITE_WALMART_AD_ID=your_walmart_ad_id
VITE_TARGET_CAMPAIGN_ID=your_target_campaign_id
VITE_TARGET_AD_ID=your_target_ad_id
VITE_KROGER_CAMPAIGN_ID=your_kroger_campaign_id
VITE_KROGER_AD_ID=your_kroger_ad_id
VITE_INSTACART_CAMPAIGN_ID=your_instacart_campaign_id
VITE_INSTACART_AD_ID=your_instacart_ad_id
VITE_ALBERTSONS_CAMPAIGN_ID=your_albertsons_campaign_id
VITE_ALBERTSONS_AD_ID=your_albertsons_ad_id
VITE_THRIVE_CAMPAIGN_ID=your_thrive_campaign_id
VITE_THRIVE_AD_ID=your_thrive_ad_id

# Open Price Engine (openpricengine.com) — separate paid/tiered grocery price API,
# not yet integrated into groceryPriceService.ts (which currently uses the free
# openfoodfacts.org Open Prices API for read fallback).
VITE_OPENPRICENGINE_API_KEY=your_openpricengine_api_key
