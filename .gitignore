# Local build/tool caches — regenerate on their own, shouldn't be tracked
.firebase/hosting.*.cache
.gradle/9.4.1/fileHashes/fileHashes.lock

# graphify local working files — keep only graph.json (needed to query the graph),
# skip graph.html/GRAPH_REPORT.md/cache/manifest etc.
graphify-out/*
!graphify-out/graph.json
.claude/settings.json.graphify-bak

# Local ad-hoc audit output (not the tracked deploy-checker.md/env-validator.md pair)
.claude/audits/AUDIT_CODE.md
.claude/audits/AUDIT_UI.md

.claude/dashboard/dashboard.html
