{
  "permissions": {
    "allow": [
      "Bash(npx vitest run *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npx eslint *)",
      "Bash(npm install)",
      "Bash(npm start)",
      "Bash(npx start)",
      "Bash(npx browser-use)",
      "Bash(npm run test:e2e)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/cjohn/.local/bin/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/cjohn/.local/bin/graphify.EXE hook-guard read"
          }
        ]
      }
    ]
  }
}