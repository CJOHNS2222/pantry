rules_version = '2';
/**
 * Firestore Security Rules for Smart Pantry Chef
 *
 * Security improvements implemented:
 * - Admin-only access for system and app version collections
 * - Data validation for user-generated content (recipes, ratings, prices)
 * - User ownership validation for updates/deletes
 * - Reasonable data limits to prevent abuse
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin (admins collection)
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists();
    }

    // Helpers for the leaderboard_cache/global doc (see match block below).
    function priorLeaderboardMap(field) {
      return resource == null ? {} : resource.data.get(field, {});
    }

    function changedHouseholdLeaderboardKeys() {
      return request.resource.data.householdEntries.diff(priorLeaderboardMap('householdEntries')).affectedKeys();
    }

    // Generic "whole doc as a dynamic-keyed map" helper, for collections like
    // image_cache/{shard} and price_cache/priceData where the document IS the map
    // (no wrapper field) and there's no fixed field name to diff against.
    function priorMap() {
      return resource == null ? {} : resource.data;
    }

    // Absolute ceiling on household size, independent of per-tier enforcement in
    // app logic/Cloud Functions (services/usageService.ts canAddHouseholdMember:
    // free 2 / premium 3 / family 5 today). This is only a sane upper bound so a
    // client-direct write can't grow memberIds unbounded; the real tier caps stay
    // enforced server-side.
    function withinHouseholdMemberCeiling() {
      return request.resource.data.memberIds.size() <= 5;
    }

    // ownerId is immutable via client writes. The only legitimate ownership
    // transfer today is functions/src/deleteAccount.ts (owner deletes their
    // account -> ownership passed to another member), which runs with the Admin
    // SDK and bypasses these rules entirely.
    function ownerIdUnchanged() {
      return request.resource.data.get('ownerId', null) == resource.data.get('ownerId', null);
    }

    // A plain member-initiated write may only ever remove the CALLER'S OWN uid
    // from memberIds - never add a uid (membership grants happen exclusively via
    // the acceptInvitation/inviteMember Cloud Functions using the Admin SDK, which
    // bypass these rules entirely) and never remove anyone else's uid (that stays
    // admin-gated in functions/src/removeHouseholdMember.ts / leaveHousehold.ts).
    function memberIdsChangeAllowed() {
      return request.resource.data.memberIds == resource.data.memberIds
        || (
          request.resource.data.memberIds is list
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          // No uid may be added.
          && request.resource.data.memberIds.hasOnly(resource.data.memberIds)
          // Every remaining uid was already present, and the only uid missing
          // relative to the old list is (at most) the caller's own.
          && resource.data.memberIds.hasOnly(request.resource.data.memberIds + [request.auth.uid])
          // The caller must actually be the one who left.
          && !(request.auth.uid in request.resource.data.memberIds)
        );
    }

    // Mirrors memberIdsChangeAllowed(): `members` may only shrink by exactly one
    // entry (removal), never grow or have an existing entry edited in place - so a
    // member can't self-promote their own entry's role to 'admin', add an
    // outsider's entry, or overwrite someone else's entry. Kept in lockstep with
    // memberIds so the two arrays can't diverge.
    function membersChangeAllowed() {
      return request.resource.data.members == resource.data.members
        || (
          request.resource.data.members is list
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.members.hasOnly(resource.data.members)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        );
    }

    // Helpers for the image_cache/{shard} collection (see match block below).
    function imageCacheAffectedKeys() {
      return request.resource.data.diff(priorMap()).affectedKeys();
    }

    function isValidImageCacheEntry(entry) {
      return entry is map
        && entry.cachedUrl is string
        && entry.cachedUrl.size() < 2000
        && entry.cachedUrl.matches('^https://firebasestorage\\.googleapis\\.com/.*');
    }

    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // `subscription` (tier/status/expiry) is the paywall entitlement - only
    // functions/src/verifyPurchase.ts and subscriptionNotifications.ts may set
    // it, both via the Admin SDK (bypasses these rules). A plain client write
    // must leave it untouched on update, and on create may only write the
    // hardcoded free-tier default hooks/useAuth.ts sets for a brand-new doc -
    // otherwise a client could self-grant premium/family with set({subscription:{tier:'family'}}).
    function newSubscriptionIsFree() {
      return !('subscription' in request.resource.data)
        || (request.resource.data.subscription.tier == 'free'
            && request.resource.data.subscription.status == 'active');
    }

    function subscriptionUnchanged() {
      return request.resource.data.get('subscription', null) == resource.data.get('subscription', null);
    }

    // A user can create their own user document and read/write to all of their own data (documents and subcollections)
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId && newSubscriptionIsFree();
      allow update: if request.auth != null && request.auth.uid == userId && subscriptionUnchanged();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/{documents=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Households top-level doc - create allowed if creator included in memberIds
    match /households/{householdId} {
      allow create: if request.auth != null
        && request.resource.data.memberIds is list
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.memberIds;

      // Allow only household members to read household data
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;

      // Update: caller must already be a member. ownerId is immutable; a plain
      // member-initiated write to memberIds/members may only remove the caller's
      // own entry (never add anyone or edit/remove someone else's) - all other
      // membership mutation is routed through Cloud Functions using the Admin
      // SDK, which bypass these rules entirely.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && ownerIdUnchanged()
        && memberIdsChangeAllowed()
        && membersChangeAllowed()
        && withinHouseholdMemberCeiling();

      // Owner-only: any-member delete let a non-owner nuke the household doc,
      // whose subcollection rules then null out memberIds and lock everyone
      // else out too. Ownership transfer stays admin-gated (see ownerIdUnchanged()).
      // Fallback: households created before ownerId existed have no owner on
      // file - fall back to the old any-member behavior for those only, so
      // this doesn't brick delete for every pre-existing household.
      allow delete: if request.auth != null && (
        resource.data.get('ownerId', null) == request.auth.uid
        || (resource.data.get('ownerId', null) == null && request.auth.uid in resource.data.memberIds)
      );
    }

    // Household subcollections: check membership in household document
    match /households/{householdId}/{subCollection=**} {
      allow read, write: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    // Note: product_master collection removed; denormalized item fields used instead.

    // Household cache documents - explicit rule for cache
    match /households/{householdId}/cache/{cacheDoc} {
      allow read, write: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    // Per-user saved recipes cache: single document storing an array of saved recipes
    match /users/{userId}/cache/savedRecipes {
      allow read, write: if request.auth != null && request.auth.uid == userId
        && (
          // Basic validation on write: recipes array and lastUpdated present
          request.resource.data.keys().hasAny(['recipes', 'lastUpdated'])
        );
    }

    // Public ratings collection (Community) - restrict to authenticated users with validation
    match /ratings/{docId} {
      allow read: if request.auth != null; // Require authentication for reading ratings
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['recipeId', 'rating', 'userId'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5; // Valid rating range
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Recipe ratings collection - allow authenticated users to read/write their own ratings
    match /recipeRatings/{docId} {
      allow read: if request.auth != null; // Require authentication for reading ratings
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['recipeTitle', 'rating', 'userId'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5; // Valid rating range
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Feedback collection: allow authenticated users to create feedback but with limits
    match /feedback/{docId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAny(['message'])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && ( !('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid );
      allow read: if false; // Only allow creation, no reading for privacy
      allow update, delete: if isAdmin();
    }

    // Notifications collection: users can only access their own notifications
    // userId may be a UID or an email address (pre-registration invites)
    match /notifications/{notificationId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.token.email == resource.data.userId
      );
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.token.email == resource.data.userId
      );
    }

    // App versions collection: allow read for all authenticated users, write only for admins
    match /app_versions/{platform} {
      allow read: if request.auth != null; // Require authentication for version checks
      allow write: if isAdmin(); // Only admins can update version info
    }

    // Grocery prices collection: allow authenticated users to contribute but validate data
    match /groceryPrices/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['itemName', 'price', 'store', 'userId'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.price < 1000; // Reasonable price limit
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Price history collection: allow authenticated users to contribute historical data
    match /priceHistory/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['itemName', 'price', 'store', 'date', 'userId'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.price < 1000;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Global recipes collection: allow public recipes and private user-owned recipes.
    // Clients may save recipes as private (visibility: 'private') so only the owner can read them.
    match /recipes/{recipeId} {
      // Read rules:
      // - Public recipes are readable by any authenticated user
      // - Private recipes are readable only by their owner
      allow get, list: if request.auth != null && (
        // If resource exists, allow read when public
        (resource.data.visibility == 'public') ||
        // Or allow read for owner (private or otherwise)
        (resource.data.userId == request.auth.uid)
      );

      // Create: authenticated users may create recipes and must set `userId` to their UID.
      // If `visibility` is present it must be either 'public' or 'private'.
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['title', 'userId'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 200
        && (
          !('visibility' in request.resource.data) ||
          (request.resource.data.visibility in ['public', 'private'])
        );

      // Update: only the owner can modify their recipe. Owners can change visibility,
      // but userId itself is immutable (security L1) - otherwise an owner could
      // reassign a recipe doc to another uid or launder a stolen recipe id.
      allow update: if request.auth != null && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && (
          // On update, if visibility is being set ensure it's valid
          !(('visibility' in request.resource.data) && !(request.resource.data.visibility in ['public', 'private']))
        );

      // Delete: only the owner. (No request.resource on delete, so this is split
      // out from update rather than sharing one allow update, delete clause.)
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Recipe submissions (recipes submitted for staff review) are stored under `recipes/submissions/{submissionId}`
    // - Any authenticated user may create a submission for their recipe; `submitterId` must match auth uid and `status` must be 'pending'
    // - Submitter and admins may read the submission; only admins may update status fields
    match /recipes/submissions/{submissionId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['title', 'userId', 'submitterId', 'status'])
        && request.resource.data.submitterId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 200
        && request.resource.data.status == 'pending';

      allow read: if request.auth != null && (
        resource.data.submitterId == request.auth.uid || isAdmin()
      );

      // Only admins may change the submission status (approve/reject). Allow admins to update.
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && (isAdmin() || resource.data.submitterId == request.auth.uid);
    }

    // Recipe search index: read-only for authenticated users, admin write access
    match /recipe_search_index/{recipeId} {
      allow read: if request.auth != null; // Allow authenticated users to search
      allow write: if isAdmin(); // Only admins can update the search index
    }

    // Recipe modifications collection: allow authenticated users to suggest modifications
    match /recipeModifications/{docId} {
      allow read: if request.auth != null; // Allow authenticated users to read modifications
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['recipeTitle', 'userId', 'description'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() < 500; // Reasonable description length
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Recipe community stats: clients should NOT be allowed to arbitrarily update aggregated stats.
    // Only admin processes (or server-side scripts using the Admin SDK) should write these documents.
    match /recipeCommunityStats/{docId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin();
    }

    // Image cache: sharded into image_cache/shard_00 .. shard_NN (see
    // IMAGE_CACHE_SHARD_COUNT in services/imageCacheService.ts) instead of one
    // unbounded global doc, so no single doc can hit Firestore's 1MB cap.
    // Each shard doc IS the map (keyed by lowercased item-name cache key -> a
    // { originalUrl, cachedUrl, itemName, createdAt, lastUsed } entry) - same
    // "dynamic keys, no per-entry field addressing" limitation as price_cache
    // below applies for batch writes, but for the common single-entry write
    // (services/imageCacheService.ts cacheImageFromUrl) we CAN pin down the one
    // changed key via diff().affectedKeys().toList()[0] (same technique
    // leaderboard_cache/global uses) and validate its cachedUrl is actually a
    // Firebase Storage download URL - imageCacheService.ts always re-uploads any
    // externally-sourced image to Storage before caching, so a legitimate write
    // never needs to point cachedUrl anywhere else, and this stops a rogue
    // authenticated client from poisoning the cache with an arbitrary/malicious URL
    // served to every other client.
    match /image_cache/{shardId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        // Only real shard doc ids - no stray docs under this collection.
        && shardId.matches('^shard_[0-9]+$')
        // Keep an individual shard well under the 1MB cap even if app-side
        // pruning (services/imageCacheService.ts MAX_ENTRIES_PER_SHARD) is
        // skipped/buggy client-side.
        && request.resource.data.keys().size() <= 400
        // A single write may only touch a handful of entries - the real client
        // writes one at a time (cacheImageFromUrl) or in batches of 3
        // (cacheImagesFromUrls' batchSize); this bounds abuse rate for a rogue
        // client trying to rewrite many entries in one call.
        && imageCacheAffectedKeys().size() >= 1
        && imageCacheAffectedKeys().size() <= 5
        && (
          // For the common single-entry write, validate the entry's URL is a
          // Storage download URL. Multi-key batch writes fall back to the
          // count/size bounds above only - see price_cache below for why
          // per-entry validation of an arbitrary-keyed map's every changed
          // entry isn't expressible in this rules language.
          imageCacheAffectedKeys().size() != 1
          || isValidImageCacheEntry(request.resource.data.get(imageCacheAffectedKeys().toList()[0], null))
        );
      allow delete: if isAdmin();
    }

    // Price data cache: single global document keyed by lowercased item name, each value a
    // PriceData record (see services/priceDataCacheService.ts). Any authenticated user may
    // write the whole doc (client-side cache warms on demand), but the shape is validated the
    // same way leaderboard_cache/global and system/community_rated_recipes validate theirs.
    match /price_cache/priceData {
      allow read: if request.auth != null;
      // NOTE: Firestore Rules v2 has no lambda/quantifier macro for iterating an arbitrary-
      // keyed map's values (no `.all()`/`.any()` on lists or maps - only hasAll/hasAny/
      // hasOnly/size are supported, and per-item-name keys here are dynamic so individual
      // fields can't be addressed directly the way leaderboard_cache/global addresses
      // `entries`/`householdEntries`). Per-entry shape (averagePrice/minPrice/maxPrice/
      // sampleSize/unit/lastUpdated) is therefore left to the client
      // (services/priceDataCacheService.ts) rather than enforced here; rules are limited to
      // top-level shape and size to keep the document from growing unbounded. Client code
      // (priceDataCacheService.ts) writes this doc directly today, so this stays
      // client-writable rather than function-write-only - tightened instead with a bound on
      // how many item entries a single write may touch.
      allow write: if request.auth != null
        && request.resource.data.keys().size() <= 500
        && request.resource.data.diff(priorMap()).affectedKeys().size() <= 100;
    }

    // Global leaderboard cache: single shared document holding every opted-in user's
    // entry (keyed by uid) and every opted-in household's entry (keyed by householdId),
    // so reading the leaderboard is 1 read instead of N. Any authenticated user may
    // read it; a write may only touch the caller's own key in `entries`, and/or one
    // household key in `householdEntries` that the caller is actually a member of.
    match /leaderboard_cache/global {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.entries is map
        && request.resource.data.householdEntries is map
        // Own user entry: only the caller's own uid key may change.
        && request.resource.data.entries.diff(priorLeaderboardMap('entries')).affectedKeys().hasOnly([request.auth.uid])
        // Household entry: at most one household key may change, and only if the caller
        // is a member of that household.
        && changedHouseholdLeaderboardKeys().size() <= 1
        && (
          changedHouseholdLeaderboardKeys().size() == 0
          || (
            request.auth.uid in get(/databases/$(database)/documents/households/$(changedHouseholdLeaderboardKeys().toList()[0])).data.memberIds
          )
        );
    }

    // System collection: allow read access for authenticated users (for cached data like popular recipes)
    // Allow authenticated users to read any system doc, but allow client writes only to the
    // single-document community cache `system/community_rated_recipes` with basic validation.
    match /system/community_rated_recipes {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        // expect a recipes array and lastUpdated
        && request.resource.data.keys().hasAny(['recipes', 'lastUpdated'])
        && request.resource.data.recipes is list
        // keep document size reasonable
        && request.resource.data.recipes.size() <= 500;
    }

    // Other system documents remain admin-only for writes
    match /system/{docId} {
      allow read: if request.auth != null; // Authenticated users can read system data
      allow write: if isAdmin(); // Only admins can write other system data
    }

    // Recipe cache documents: allow authenticated users to read cache documents
    // (These documents are generated by admin scripts and should be readable by
    // authenticated clients to avoid fan-out reads across many recipe docs.)
    match /recipe_caches/{cacheDoc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
